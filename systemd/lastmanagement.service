[Unit]
Description=Lastmanagement für Ladestationen (Modbus TCP)
Documentation=https://github.com/derhofib/lastmanagment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedizierter Benutzer empfohlen (siehe README)
User=lastmanager
Group=lastmanager

WorkingDirectory=/opt/lastmanagement
Environment=LM_CONFIG=/opt/lastmanagement/config.yaml
# Bei Bedarf weitere Werte überschreiben:
# Environment=LM_DATABASE_URL=sqlite:////opt/lastmanagement/data/lastmanagement.db
# Environment=LM_LOG_LEVEL=INFO

ExecStart=/opt/lastmanagement/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000

# Robustheit im Dauerbetrieb
Restart=always
RestartSec=5
TimeoutStopSec=20

# Logging nach journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lastmanagement

# Härtung (optional, an Umgebung anpassen)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
